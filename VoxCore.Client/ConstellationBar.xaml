<UserControl
    x:Class="VoxCore.Client.ConstellationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="72" Background="#030306">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Border Grid.Row="0" Width="48" Height="48" CornerRadius="24" Background="#08080e"
                BorderBrush="#181820" BorderThickness="1" Margin="0,12,0,8"
                HorizontalAlignment="Center" IsHitTestVisible="True">
            <TextBlock Text="V" FontFamily="Cascadia Code" FontWeight="Bold" FontSize="20"
                       Foreground="#00e5ff" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Separator -->
        <Border Grid.Row="0" Height="2" Width="32" Background="#181820"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" />

        <!-- Server list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Margin="0,8,0,0">
            <StackPanel x:Name="ServerList" Spacing="4" HorizontalAlignment="Center" />
        </ScrollViewer>

        <!-- Add server button -->
        <Button Grid.Row="2" x:Name="AddServerBtn" Width="48" Height="48" Padding="0"
                Background="Transparent" BorderBrush="#181820" BorderThickness="1" CornerRadius="24"
                HorizontalAlignment="Center" Margin="0,0,0,4"
                ToolTipService.ToolTip="создать звёздную систему"
                Click="AddServerBtn_Click">
            <TextBlock Text="＋" FontFamily="Cascadia Code" FontSize="22" Foreground="#3ba55d" />
        </Button>

        <!-- Settings gear -->
        <Button Grid.Row="3" x:Name="GearBtn" Width="48" Height="48" Padding="0"
                Background="Transparent" BorderBrush="#181820" BorderThickness="1" CornerRadius="24"
                HorizontalAlignment="Center" Margin="0,0,0,12"
                ToolTipService.ToolTip="навигационная консоль"
                Click="GearBtn_Click">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#5a5a6a" />
        </Button>
    </Grid>
</UserControl>
