<UserControl
    x:Class="VoxCore.Client.CrewManifest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="248" Background="#08080e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="ЭКИПАЖ" FontFamily="Cascadia Code" FontSize="11"
                   Foreground="#5a5a6a" Padding="16,14" />

        <!-- Members list -->
        <ListView x:Name="MembersListView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                  SelectionMode="None" Padding="8,0,8,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,3" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="30" Height="30" Margin="0,0,8,0">
                            <Border Width="30" Height="30" CornerRadius="15"
                                    Background="{Binding ColorBrush}">
                                <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code"
                                           FontWeight="Bold" Foreground="White" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="10" Height="10" CornerRadius="5"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Margin="0,0,-2,-2" Visibility="{Binding SpeakingBorderVisibility}">
                                <Border.Background>
                                    <SolidColorBrush Color="#3ba55d" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code" FontSize="12"
                                           Foreground="#e8e8f0" />
                                <TextBlock Text="{Binding SpeakingText}" FontSize="9"
                                           Foreground="{Binding SpeakingBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="на голографической связи" FontFamily="Cascadia Code" FontSize="9"
                                       Foreground="#5a5a6a" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
