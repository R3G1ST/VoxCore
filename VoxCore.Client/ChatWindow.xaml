<Window
    x:Class="VoxCore.Client.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoxCore.Client">
    <Grid Background="#1e1f22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2b2d31" BorderBrush="#1e1f22" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="#3ba55d" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ChatTitle" Text="чат" FontFamily="Cascadia Code" FontSize="14"
                               FontWeight="Bold" Foreground="#f2f3f5" />
                    <TextBlock x:Name="ChatSubtitle" Text="" FontFamily="Cascadia Code" FontSize="11"
                               Foreground="#949ba4" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="32" Height="32" Padding="0"
                        Background="#ed4245" Foreground="White" BorderThickness="0"
                        CornerRadius="6" FontFamily="Cascadia Code" FontSize="14"
                        Click="CloseBtn_Click" />
            </Grid>
        </Border>

        <ListView x:Name="MessagesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                  SelectionMode="None" VerticalAlignment="Stretch" Padding="8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SenderName}" FontFamily="Cascadia Code" FontSize="12"
                                       FontWeight="Bold" Foreground="#f2f3f5" />
                            <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Code" FontSize="10"
                                       Foreground="#5a5a6a" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Cascadia Code" FontSize="13"
                                   Foreground="#dbdee1" TextWrapping="Wrap" Margin="14,2,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Background="#2b2d31" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" PlaceholderText="напиши сообщение..."
                     FontFamily="Cascadia Code" FontSize="13" Background="#313338" Foreground="#dbdee1"
                     BorderBrush="#3f4248" BorderThickness="1" CornerRadius="8" Padding="12,8"
                     KeyDown="MessageInput_KeyDown" />
            <Button Grid.Column="1" Content="➤" Width="40" Height="40" Padding="0"
                    Background="#5865f2" Foreground="White" BorderThickness="0"
                    CornerRadius="8" FontFamily="Cascadia Code" FontSize="16"
                    Margin="8,0,0,0" Click="SendBtn_Click" />
        </Grid>
    </Grid>
</Window>
