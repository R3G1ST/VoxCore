<UserControl
    x:Class="VoxCore.Client.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#070810">
        <Grid.Resources>
            <LinearGradientBrush x:Key="NeonStroke" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00e5ff" Offset="0" />
                <GradientStop Color="#8b5cf6" Offset="0.5" />
                <GradientStop Color="#ff2ec4" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="NeonBtn" TargetType="Button">
                <Setter Property="Background" Value="#d90d0f1e" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#9fefff" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,12">
            <Border Padding="24,8" CornerRadius="12" BorderThickness="2"
                    BorderBrush="{StaticResource NeonStroke}" Background="#d90d0f1e">
                <TextBlock Text="НАСТРОЙКИ" FontFamily="Cascadia Code" FontSize="15"
                           FontWeight="Bold" Foreground="#eaf7ff" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,8,24,8" Spacing="18">

                <!-- VOICE PIPELINE STATUS -->
                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ГОЛОСОВОЙ PIPELINE" FontFamily="Cascadia Code" FontSize="11" Foreground="#7fe3ff" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="OpusDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Opus 48kHz моно" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="OpusStatus" Text="64 kbps" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HpfDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="HPF 80Hz (резка гула)" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="HpfStatus" Text="активен" FontFamily="Cascadia Code" FontSize="11" Foreground="#2eea8b" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="AecDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="AEC3 эхоподавление" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="AecStatus" Text="активен" FontFamily="Cascadia Code" FontSize="11" Foreground="#2eea8b" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RnnoiseDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="RNNoise шумоподавление" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="RnnoiseStatus" Text="активно" FontFamily="Cascadia Code" FontSize="11" Foreground="#2eea8b" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="DfDot" Width="8" Height="8" Fill="#ff3b5c" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="DeepFilterNet3 (Deep Noise Suppression)" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="DfStatus" Text="не загружен" FontFamily="Cascadia Code" FontSize="11" Foreground="#ff3b5c" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="AgcDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="AGC автокомпрессия" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="AgcStatus" Text="активен 0dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#2eea8b" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="FecDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="FEC Forward Error Correction" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="FecStatus" Text="активно" FontFamily="Cascadia Code" FontSize="11" Foreground="#2eea8b" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="VadDot" Width="8" Height="8" Fill="#faa61a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Silero VAD (детектор речи)" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="VadStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="GateDot" Width="8" Height="8" Fill="#2eea8b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Noise Gate −40dB" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="GateStatus" Text="активен" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CONNECTION STATUS -->
                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontFamily="Cascadia Code" FontSize="11" Foreground="#ff9fe8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#ff3b5c" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Протокол" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="ConnProtocol" Text="не подключен" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="IceDot" Width="8" Height="8" Fill="#ff3b5c" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="ICE соединение" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="IceStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="TurnDot" Width="8" Height="8" Fill="#ff3b5c" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="TURN сервер" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TurnStatus" Text="194.31.204.5:3478" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="PingDot" Width="8" Height="8" Fill="#5a617a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Пинг до сервера" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="PingStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="JitDot" Width="8" Height="8" Fill="#5a617a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Jitter buffer (цель / буфер)" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="JitStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="LossDot" Width="8" Height="8" Fill="#5a617a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Потери кадров (PLC)" FontFamily="Cascadia Code" FontSize="12" Foreground="#dbe6ff" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="LossStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MIC CONTROL -->
                <StackPanel Spacing="8">
                    <TextBlock Text="МИКРОФОН" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <ComboBox x:Name="MicCombo" MinWidth="300" HorizontalAlignment="Left"
                              FontFamily="Cascadia Code" FontSize="12"
                              Background="#0a0c18" Foreground="#dbe6ff" BorderBrush="#00e5ff" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="ГРОМКОСТЬ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GainSlider" Minimum="0" Maximum="200" StepFrequency="5" />
                        <TextBlock x:Name="GainText" Grid.Column="1" MinWidth="44" Text="100%"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#9fefff"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="ШУМОПОДАВЛЕНИЕ (RNNoise)" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <ToggleSwitch x:Name="NsToggle" OnContent="вкл" OffContent="выкл" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="AGC АВТОКОМПРЕССИЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <ToggleSwitch x:Name="AgcToggle" OnContent="вкл" OffContent="выкл" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="DEEPFILTER ПРЕДЕЛ ПОДАВЛЕНИЯ (после переподключения)" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DfAttSlider" Minimum="6" Maximum="60" StepFrequency="2" />
                        <TextBlock x:Name="DfAttText" Grid.Column="1" MinWidth="52" Text="60 dB"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#9fefff"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ЭКВАЛАЙЗЕР (МАСТЕР) — применится сразу" FontFamily="Cascadia Code" FontSize="11" Foreground="#7fe3ff" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Низ 200Hz" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqLowSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqLowText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#9fefff" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сред 1kHz" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqMidSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqMidText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#9fefff" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Верх 4kHz" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqHighSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqHighText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#9fefff" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="ГРОМКОСТЬ" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" />
                        <TextBlock x:Name="VolumeText" Grid.Column="1" MinWidth="44" Text="80%"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#9fefff"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- MIC TEST -->
                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ТЕСТ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#7fe3ff" />
                        <CheckBox x:Name="LoopbackCheck" Content="слушать себя" FontFamily="Cascadia Code"
                                  FontSize="12" Foreground="#dbe6ff" />
                        <Button x:Name="TestBtn" Content="НАЧАТЬ ТЕСТ" Style="{ThemeResource VcSmallButton}"
                                HorizontalAlignment="Stretch" Click="TestBtn_Click" />
                        <Border x:Name="MeterTrack" Height="14" CornerRadius="7" Background="#0a0c18"
                                BorderBrush="#2a2f55" BorderThickness="1">
                            <Border x:Name="MeterFill" Width="0" CornerRadius="7" Background="#00e5ff"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="TestInfo" Text="" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a" />
                    </StackPanel>
                </Border>

                <!-- SERVER SELECT -->
                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="СЕРВЕР" FontFamily="Cascadia Code" FontSize="11" Foreground="#7fe3ff" />
                        <ComboBox x:Name="ServerCombo" MinWidth="300" HorizontalAlignment="Left"
                                  FontFamily="Cascadia Code" FontSize="12"
                                  Background="#0a0c18" Foreground="#dbe6ff" BorderBrush="#00e5ff"
                                  SelectionChanged="ServerCombo_SelectionChanged" />
                        <TextBlock x:Name="ServerInfo" Text="" FontFamily="Cascadia Code" FontSize="11"
                                   Foreground="#5a617a" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- UPDATES -->
                <Border Background="#d90d0f1e" BorderBrush="{StaticResource NeonStroke}" BorderThickness="2"
                        CornerRadius="14" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ОБНОВЛЕНИЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#ff9fe8" />
                        <TextBlock x:Name="VerText" Text="" FontFamily="Cascadia Code" FontSize="13"
                                   FontWeight="Bold" Foreground="#eaf7ff" />
                        <TextBlock x:Name="UpdateStatus" Text="нажми «ПРОВЕРИТЬ ОБНОВЛЕНИЯ»" FontFamily="Cascadia Code"
                                   FontSize="11" Foreground="#5a617a" TextWrapping="Wrap" />
                        <Button x:Name="CheckUpdateBtn" Content="ПРОВЕРИТЬ ОБНОВЛЕНИЯ" Style="{ThemeResource VcSmallButton}"
                                HorizontalAlignment="Stretch" Click="CheckUpdateBtn_Click" />
                        <Button x:Name="InstallUpdateBtn" Content="СКАЧАТЬ И УСТАНОВИТЬ" Style="{ThemeResource VcSmallButton}"
                                Background="#0f2d1c" Foreground="#7dffb0" BorderBrush="#2eea8b"
                                HorizontalAlignment="Stretch" Visibility="Collapsed"
                                Click="InstallUpdateBtn_Click" />
                        <ProgressBar x:Name="UpdateProgress" Maximum="1" Minimum="0" Value="0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                    Padding="0,4,20,20">
            <Button Content="ЗАКРЫТЬ" Style="{StaticResource NeonBtn}" BorderBrush="#ff2ec4" Click="CloseBtn_Click" />
            <Button Content="СОХРАНИТЬ" Style="{StaticResource NeonBtn}" BorderBrush="#00e5ff" Click="SaveBtn_Click" />
        </StackPanel>
    </Grid>
</UserControl>
