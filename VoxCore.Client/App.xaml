<Application
    x:Class="VoxCore.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoxCore.Client">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BgBrush" Color="#030306" />
            <SolidColorBrush x:Key="CardBrush" Color="#08080e" />
            <SolidColorBrush x:Key="BorderBrush" Color="#181820" />
            <SolidColorBrush x:Key="AccentBrush" Color="#00ff88" />
            <SolidColorBrush x:Key="DimBrush" Color="#5a5a6a" />
            <SolidColorBrush x:Key="UserColorBrush" Color="#5865f2" />
            <Style x:Key="VcButton" TargetType="Button">
                <Setter Property="Background" Value="#08080e" />
                <Setter Property="Foreground" Value="#e8e8f0" />
                <Setter Property="BorderBrush" Value="#181820" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="VcTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#08080e" />
                <Setter Property="Foreground" Value="#e8e8f0" />
                <Setter Property="BorderBrush" Value="#181820" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style x:Key="VcLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5a5a6a" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="VcTabButton" TargetType="Button">
                <Setter Property="Background" Value="#08080e" />
                <Setter Property="Foreground" Value="#e8e8f0" />
                <Setter Property="BorderBrush" Value="#181820" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
            <Style x:Key="VcSmallButton" TargetType="Button">
                <Setter Property="Background" Value="#5865f2" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style x:Key="AuthTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#1e1f22" />
                <Setter Property="Foreground" Value="#dbdee1" />
                <Setter Property="BorderBrush" Value="#3f4248" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="AuthPassBox" TargetType="PasswordBox">
                <Setter Property="Background" Value="#1e1f22" />
                <Setter Property="Foreground" Value="#dbdee1" />
                <Setter Property="BorderBrush" Value="#3f4248" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="AuthButton" TargetType="Button">
                <Setter Property="Background" Value="#5865f2" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style x:Key="AuthLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#00a8fc" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>