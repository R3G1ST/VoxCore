<Window
    x:Class="VoxCore.Client.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#2b2d31">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#1e1f22" BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="НАСТРОЙКИ" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold" Foreground="White" />
        </Border>

        <StackPanel Grid.Row="1" Padding="24,20" Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock Text="МИКРОФОН" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                <ComboBox x:Name="MicCombo" MinWidth="300" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="ГРОМКОСТЬ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="GainSlider" Minimum="0" Maximum="200" StepFrequency="5" />
                    <TextBlock x:Name="GainText" Grid.Column="1" MinWidth="44" Text="100%"
                               FontFamily="Cascadia Code" FontSize="12" Foreground="#dbdee1"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="ШУМОПОДАВЛЕНИЕ (RNNoise)" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                <ToggleSwitch x:Name="NsToggle" OnContent="вкл" OffContent="выкл" />
            </StackPanel>

            <Border Background="#1e1f22" CornerRadius="10" Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="ТЕСТ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                    <CheckBox x:Name="LoopbackCheck" Content="слушать себя" FontFamily="Cascadia Code"
                              FontSize="12" Foreground="#dbdee1" />
                    <Button x:Name="TestBtn" Content="НАЧАТЬ ТЕСТ" Style="{ThemeResource VcSmallButton}"
                            HorizontalAlignment="Stretch" Click="TestBtn_Click" />
                    <Border x:Name="MeterTrack" Height="14" CornerRadius="7" Background="#313338">
                        <Border x:Name="MeterFill" Width="0" CornerRadius="7" Background="#3ba55d"
                                HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="TestInfo" Text="" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                </StackPanel>
            </Border>

            <Border Background="#1e1f22" CornerRadius="10" Padding="16,14">
                <StackPanel Spacing="10">
                    <TextBlock Text="ОБНОВЛЕНИЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                    <TextBlock x:Name="VerText" Text="" FontFamily="Cascadia Code" FontSize="13"
                               FontWeight="Bold" Foreground="#dbdee1" />
                    <TextBlock x:Name="UpdateStatus" Text="нажми «ПРОВЕРИТЬ ОБНОВЛЕНИЯ»" FontFamily="Cascadia Code"
                               FontSize="11" Foreground="#949ba4" TextWrapping="Wrap" />
                    <Button x:Name="CheckUpdateBtn" Content="ПРОВЕРИТЬ ОБНОВЛЕНИЯ" Style="{ThemeResource VcSmallButton}"
                            HorizontalAlignment="Stretch" Click="CheckUpdateBtn_Click" />
                    <Button x:Name="InstallUpdateBtn" Content="СКАЧАТЬ И УСТАНОВИТЬ" Style="{ThemeResource VcSmallButton}"
                            Background="#3ba55d" HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Click="InstallUpdateBtn_Click" />
                    <ProgressBar x:Name="UpdateProgress" Maximum="1" Minimum="0" Value="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                    Padding="0,0,20,20">
            <Button Content="ЗАКРЫТЬ" Style="{ThemeResource VcSmallButton}" Background="#3f4248"
                    Click="CloseBtn_Click" />
            <Button Content="СОХРАНИТЬ" Style="{ThemeResource VcSmallButton}" Click="SaveBtn_Click" />
        </StackPanel>
    </Grid>
</Window>