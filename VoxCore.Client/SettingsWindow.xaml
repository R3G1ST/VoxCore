<Window
    x:Class="VoxCore.Client.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0a0a12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#1a1a30" BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock Text="НАСТРОЙКИ" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold" Foreground="#00ff88" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20" Spacing="20">

                <!-- VOICE PIPELINE STATUS -->
                <Border Background="#10101c" BorderBrush="#1a1a30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ГОЛОСОВОЙ PIPELINE" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" FontWeight="Bold" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="OpusDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Opus 48kHz моно" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="OpusStatus" Text="256 kbps" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HpfDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="HPF 80Hz (резка гула)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="HpfStatus" Text="активен" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="AecDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="AEC3 эхоподавление" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="AecStatus" Text="активен" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RnnoiseDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="RNNoise шумоподавление" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="RnnoiseStatus" Text="активно" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="DfDot" Width="8" Height="8" Fill="#00e5ff" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="DeepFilterNet3 (Deep Noise Suppression)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="DfStatus" Text="загружен" FontFamily="Cascadia Code" FontSize="11" Foreground="#00e5ff" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="AgcDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="AGC автокомпрессия" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="AgcStatus" Text="активен 0dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="FecDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="FEC Forward Error Correction" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="FecStatus" Text="DRED 40ms" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="DtxDot" Width="8" Height="8" Fill="#f0a030" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="DTX (Transmission Optimization)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="DtxStatus" Text="WebRTC" FontFamily="Cascadia Code" FontSize="11" Foreground="#f0a030" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="VadDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Silero VAD (детектор речи)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="VadStatus" Text="0,00 / 0.50 тишина" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="GateDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Noise Gate −40dB" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="GateStatus" Text="зажат (−40dB)" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CONNECTION STATUS -->
                <Border Background="#10101c" BorderBrush="#1a1a30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ПОДКЛЮЧЕНИЕ" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" FontWeight="Bold" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#00ff88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Протокол" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="ConnProtocol" Text="UDP подключен" FontFamily="Cascadia Code" FontSize="11" Foreground="#00ff88" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="IceDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="ICE соединение" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="IceStatus" Text="не используется" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="TurnDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="TURN сервер" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TurnStatus" Text="не используется" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="PingDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Пинг до сервера" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="PingStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="JitDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Jitter buffer (цель / буфер)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="JitStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="LossDot" Width="8" Height="8" Fill="#6a6a8a" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Потери кадров (PLC)" FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="LossStatus" Text="—" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MIC CONTROL -->
                <StackPanel Spacing="8">
                    <TextBlock Text="МИКРОФОН" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                    <ComboBox x:Name="MicCombo" MinWidth="300" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="ГРОМКОСТЬ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="GainSlider" Minimum="0" Maximum="200" StepFrequency="5" />
                        <TextBlock x:Name="GainText" Grid.Column="1" MinWidth="44" Text="100%"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="ШУМОПОДАВЛЕНИЕ DeepFilterNet3" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="NsLevelSlider" Minimum="0" Maximum="3" StepFrequency="1" />
                        <TextBlock x:Name="NsLevelText" Grid.Column="1" MinWidth="80" Text="среднее"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock FontFamily="Cascadia Code" FontSize="10" Foreground="#4a4a6a" TextWrapping="Wrap">0=выкл · 1=мягкое · 2=среднее · 3=сильное (после переподключения)</TextBlock>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="AGC АВТОКОМПРЕССИЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                    <ToggleSwitch x:Name="AgcToggle" OnContent="вкл" OffContent="выкл" />
                </StackPanel>

                <Border Background="#10101c" BorderBrush="#1a1a30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ЭКВАЛАЙЗЕР (МАСТЕР) — применится сразу" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Низ 200Hz" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqLowSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqLowText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#e0e0f0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сред 1kHz" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqMidSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqMidText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#e0e0f0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Верх 4kHz" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" VerticalAlignment="Center"/>
                            <Slider x:Name="EqHighSlider" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" />
                            <TextBlock x:Name="EqHighText" Grid.Column="2" Text="0 dB" FontFamily="Cascadia Code" FontSize="11" Foreground="#e0e0f0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="ГРОМКОСТЬ" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" StepFrequency="5" />
                        <TextBlock x:Name="VolumeText" Grid.Column="1" MinWidth="44" Text="80%"
                                   FontFamily="Cascadia Code" FontSize="12" Foreground="#e0e0f0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- MIC TEST -->
                <Border Background="#10101c" BorderBrush="#1a1a30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ТЕСТ МИКРОФОНА" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                        <CheckBox x:Name="LoopbackCheck" Content="слушать себя" FontFamily="Cascadia Code"
                                  FontSize="12" Foreground="#e0e0f0" />
                        <Button x:Name="TestBtn" Content="НАЧАТЬ ТЕСТ" Style="{ThemeResource VcSmallButton}"
                                HorizontalAlignment="Stretch" Click="TestBtn_Click" />
                        <Border x:Name="MeterTrack" Height="14" CornerRadius="7" Background="#1a1a30">
                            <Border x:Name="MeterFill" Width="0" CornerRadius="7" Background="#00ff88"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="TestInfo" Text="" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" />
                    </StackPanel>
                </Border>

                <!-- UPDATES -->
                <Border Background="#10101c" BorderBrush="#1a1a30" BorderThickness="1" CornerRadius="12" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ОБНОВЛЕНИЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a" FontWeight="Bold" />
                        <TextBlock x:Name="VerText" Text="" FontFamily="Cascadia Code" FontSize="13"
                                   FontWeight="Bold" Foreground="#e0e0f0" />
                        <TextBlock x:Name="UpdateStatus" Text="нажми «ПРОВЕРИТЬ ОБНОВЛЕНИЯ»" FontFamily="Cascadia.Code"
                                   FontSize="11" Foreground="#6a6a8a" TextWrapping="Wrap" />
                        <Button x:Name="CheckUpdateBtn" Content="ПРОВЕРИТЬ ОБНОВЛЕНИЯ" Style="{ThemeResource VcSmallButton}"
                                HorizontalAlignment="Stretch" Click="CheckUpdateBtn_Click" />
                        <Button x:Name="InstallUpdateBtn" Content="СКАЧАТЬ И УСТАНОВИТЬ" Style="{ThemeResource VcSmallButton}"
                                Background="#00ff88" Foreground="#0a0a12" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                Click="InstallUpdateBtn_Click" />
                        <ProgressBar x:Name="UpdateProgress" Maximum="1" Minimum="0" Value="0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                    Padding="0,0,20,20">
            <Button Content="ЗАКРЫТЬ" Style="{ThemeResource VcSmallButton}"
                    Click="CloseBtn_Click" />
            <Button Content="СОХРАНИТЬ" Style="{ThemeResource NeonBtn}" Click="SaveBtn_Click" />
        </StackPanel>
    </Grid>
</Window>
