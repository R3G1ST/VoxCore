<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VoxCore.Client</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.3-beta</Version>
    <Product>VoxCore</Product>
    <AssemblyTitle>VoxCore</AssemblyTitle>
    <Description>VoxCore</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="RNNoise.NET" Version="1.0.0" />
    <None Include="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
    <!-- WinAppSDK 2.4 тянет Windows.AI.MachineLearning, который подсовывает свою
         Microsoft.ML.OnnxRuntime.dll (v0.0.0.0) и ломает SileroVad ("нет модели").
         Исключаем только managed-сборку WAIM; нативный onnxruntime остаётся (forward-compatible). -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74">
      <ExcludeAssets>lib</ExcludeAssets>
    </PackageReference>
    <None Include="models\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\webrtc-apm.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\webrtc-apm.dll')" />
    <None Include="native\opus.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\opus.dll')" />
  </ItemGroup>
  <Target Name="CopyPriAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutputPath)VoxCore.Client.pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutputPath)VoxCore.Client.pri')" />
  </Target>
</Project>




