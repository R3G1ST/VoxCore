<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VoxCore.Client</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.16</Version>
    <Product>VoxCore</Product>
    <AssemblyTitle>VoxCore</AssemblyTitle>
    <Description>Голосовой чат для игр — качество TeamSpeak, удобство Discord</Description>
  </PropertyGroup>
<ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="RNNoise.NET" Version="1.0.0" />
    <None Include="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="deep_filter_ladspa.dll" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
  </ItemGroup>
  <Target Name="CopyPriAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutputPath)VoxCore.Client.pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(OutputPath)VoxCore.Client.pri')" />
  </Target>
</Project>