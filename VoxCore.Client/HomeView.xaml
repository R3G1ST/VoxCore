<UserControl
    x:Class="VoxCore.Client.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#070810" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <LinearGradientBrush x:Key="NeonStroke" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00e5ff" Offset="0" />
                <GradientStop Color="#8b5cf6" Offset="0.5" />
                <GradientStop Color="#ff2ec4" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="NeonBtn" TargetType="Button">
                <Setter Property="Background" Value="#d90d0f1e" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontFamily" Value="Cascadia Code" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#9fefff" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Canvas x:Name="StarsCanvas" />

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
            <Button x:Name="HomeTitleBtn" Style="{StaticResource NeonBtn}" BorderBrush="{StaticResource NeonStroke}"
                    Padding="24,9" CornerRadius="12" Click="HomeTitleBtn_Click"
                    ToolTipService.ToolTip="аудио-хаб — сеть сектора">
                <TextBlock Text="VOXCORE // ДОМОЙ" FontFamily="Cascadia Code" FontSize="15"
                           FontWeight="Bold" Foreground="#eaf7ff" />
            </Button>
        </StackPanel>

        <!-- ДВЕ КАРТОЧКИ -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,70,0,20" MaxWidth="1060">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- КАНАЛЫ -->
            <Border Grid.Column="0" Margin="0,0,10,0" Background="#cc0d0f1e" BorderBrush="{StaticResource NeonStroke}"
                    BorderThickness="2" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ГОЛОГРАФИЧЕСКИЕ СВЯЗИ" FontFamily="Cascadia Code" FontSize="13"
                                   FontWeight="Bold" Foreground="#7fe3ff" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" x:Name="AddChannelBtn" Style="{StaticResource NeonBtn}" BorderBrush="{StaticResource NeonStroke}"
                                Padding="10,5" FontSize="14" Click="AddChannelBtn_Click"
                                ToolTipService.ToolTip="создать сектор">
                            <TextBlock Text="＋" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" x:Name="ChannelChatEntry" Background="#3300e5ff" BorderBrush="#00e5ff"
                            BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8"
                            Visibility="Collapsed" Tapped="ChannelChatEntry_Tapped" IsHitTestVisible="True">
                        <TextBlock x:Name="ChannelChatEntryText" Text="" FontFamily="Cascadia Code" FontSize="12"
                                   Foreground="#bffcff" />
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChannelsList" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ДРУЗЬЯ -->
            <Border Grid.Column="1" Margin="10,0,0,0" Background="#cc0d0f1e" BorderBrush="{StaticResource NeonStroke}"
                    BorderThickness="2" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="СОЮЗНИКИ И ПЕРЕДАЧИ" FontFamily="Cascadia Code" FontSize="13"
                               FontWeight="Bold" Foreground="#ff9fe8" Margin="0,0,0,10" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="позывной пилота..." FontFamily="Cascadia Code"
                                 FontSize="12" Background="#0a0c18" Foreground="#dbe6ff" BorderBrush="#2a2f55"
                                 BorderThickness="1" CornerRadius="8" Padding="10,6" KeyDown="SearchBox_KeyDown" />
                        <Button Grid.Column="1" x:Name="SearchBtn" Style="{StaticResource NeonBtn}"
                                BorderBrush="{StaticResource NeonStroke}" Padding="10,5" Margin="6,0,0,0"
                                Click="SearchBtn_Click" ToolTipService.ToolTip="найти и позвать">
                            <TextBlock Text="🔍" FontSize="12" />
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" x:Name="SearchResults" Spacing="4" Margin="0,0,0,8" Visibility="Collapsed" />
                    <StackPanel Grid.Row="3" x:Name="RequestsPanel" Spacing="4" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="ВХОДЯЩИЕ СИГНАЛЫ" FontFamily="Cascadia Code" FontSize="10"
                                   Foreground="#faa61a" />
                        <StackPanel x:Name="RequestsList" Spacing="4" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FriendsListPanel" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ЧАТ-ОВЕРЛЕЙ -->
        <Grid x:Name="ChatOverlay" Background="#f2070810" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,10" Background="#0d0f1e" BorderBrush="#1a1f3a" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ChatBackBtn" Style="{StaticResource NeonBtn}" BorderBrush="#ff2ec4"
                            Padding="10,5" Click="ChatBackBtn_Click">
                        <TextBlock Text="←" FontSize="14" />
                    </Button>
                    <Border Grid.Column="1" x:Name="ChatAvatar" Width="30" Height="30" CornerRadius="15"
                            Background="#5865f2" Margin="10,0,0,0">
                        <TextBlock x:Name="ChatAvatarLetter" FontFamily="Cascadia Code" FontWeight="Bold"
                                   Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatTitle" Text="" FontFamily="Cascadia Code" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#eaf7ff" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ChatSubtitle" Text="" FontFamily="Cascadia Code" FontSize="10"
                                   Foreground="#5a617a" />
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="ChatJoinBtn" Style="{StaticResource NeonBtn}"
                            BorderBrush="#00e5ff" Padding="12,6" Visibility="Collapsed" Click="ChatJoinBtn_Click">
                        <TextBlock Text="ПРИСОЕДИНИТЬСЯ" FontSize="11" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                <StackPanel x:Name="ChatMessages" Spacing="2" />
            </ScrollViewer>
            <Grid Grid.Row="2" Background="#0d0f1e" Padding="12,8" BorderBrush="#1a1f3a" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" PlaceholderText="введи звёздный журнал..." FontFamily="Cascadia Code"
                         FontSize="12" Background="#0a0c18" Foreground="#dbe6ff" BorderBrush="#2a2f55"
                         BorderThickness="1" CornerRadius="8" Padding="12,8" KeyDown="ChatInput_KeyDown" />
                <Button Grid.Column="1" x:Name="ChatSendBtn" Style="{StaticResource NeonBtn}"
                        BorderBrush="{StaticResource NeonStroke}" Padding="12,8" Margin="8,0,0,0"
                        Click="ChatSendBtn_Click">
                    <TextBlock Text="➤" FontSize="13" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
