<Window
    x:Class="VoxCore.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#313338">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="248" />
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: каналы -->
        <Grid Grid.Column="0" Background="#2b2d31">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#1e1f22" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#5865f2" CornerRadius="6" Width="26" Height="26">
                            <TextBlock Text="V" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="VoxCore" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="AddChannelBtn" Content="＋" FontSize="18"
                            Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            Foreground="#949ba4" Click="AddChannelBtn_Click"
                            ToolTipService.ToolTip="создать канал" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChannelsPanel" Padding="8,8" Spacing="2" />
            </ScrollViewer>
        </Grid>

        <!-- ЦЕНТР: голосовой канал -->
        <Grid Grid.Column="1" Background="#313338">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1e1f22" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelNameText" Text="не в канале" FontFamily="Cascadia Code"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ChannelStatusText" Text="выбери канал слева" FontFamily="Cascadia Code"
                                   FontSize="11" Foreground="#949ba4" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="LeaveChannelBtn" Content="ПОКИНУТЬ" Style="{ThemeResource VcSmallButton}"
                            Visibility="Collapsed" Click="LeaveChannelBtn_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="НАЖМИ И ГОВОРИ" FontFamily="Cascadia Code" FontSize="13" Foreground="#949ba4"
                               HorizontalAlignment="Center" />
                    <Border x:Name="PttButton" CornerRadius="14" Background="#5865f2" Padding="44,16" 
                            PointerPressed="PttButton_PointerPressed" PointerReleased="PttButton_PointerReleased"
                            PointerCanceled="PttButton_PointerReleased" PointerCaptureLost="PttButton_PointerReleased">
                        <TextBlock x:Name="PttButtonText" Text="[SPACE] PTT" FontFamily="Cascadia Code" FontSize="18"
                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="отключено" FontFamily="Cascadia Code" FontSize="12"
                           Foreground="#949ba4" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#1e1f22" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <ToggleButton x:Name="MicMuteBtn" Content="🎙️" MinWidth="48" Height="40"
                                  Checked="MicMuteBtn_Checked" Unchecked="MicMuteBtn_Unchecked" />
                    <ToggleButton x:Name="HeadMuteBtn" Content="🔊" MinWidth="48" Height="40"
                                  Checked="HeadMuteBtn_Checked" Unchecked="HeadMuteBtn_Unchecked" />
                    <ToggleButton x:Name="DeafenBtn" Content="🔇" MinWidth="48" Height="40"
                                  Checked="DeafenBtn_Checked" Unchecked="DeafenBtn_Unchecked" />
                    <Button x:Name="SettingsBtn" Content="⚙️" MinWidth="48" Height="40"
                            Click="SettingsBtn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ: участники -->
        <Grid Grid.Column="2" Background="#2b2d31">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="УЧАСТНИКИ" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4"
                       Padding="16,14" />
            <ListView x:Name="MembersList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      SelectionMode="None" Padding="8,0,8,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="6,5">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{Binding ColorBrush}">
                                <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                           Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code" FontSize="14"
                                               Foreground="#dbdee1" />
                                    <TextBlock Text="●" FontSize="12" Foreground="{ThemeResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" FontFamily="Cascadia Code" FontSize="10"
                                           Foreground="#949ba4" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- КАРТОЧКА АККАУНТА -->
        <Border Grid.Column="0" VerticalAlignment="Bottom" Background="#232428" BorderBrush="#1e1f22"
                BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AvatarBorder" Width="36" Height="36" CornerRadius="18" Background="#5865f2">
                    <TextBlock x:Name="AvatarLetter" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="White"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" FontFamily="Cascadia Code" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="UserStatusText" Text="в сети" FontFamily="Cascadia Code" FontSize="10"
                               Foreground="#3ba55d" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="34" Height="34" Padding="0" Background="Transparent"
                        BorderThickness="0" Foreground="#949ba4" Click="LogoutBtn_Click"
                        ToolTipService.ToolTip="выйти" />
            </Grid>
        </Border>
    </Grid>
</Window>