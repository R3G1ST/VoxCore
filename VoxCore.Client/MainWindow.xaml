<Window
    x:Class="VoxCore.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleDragArea" Grid.Row="0" Padding="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="VoxCore" FontFamily="Cascadia Code" FontSize="20" FontWeight="Bold"
                           Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                <Border Background="#081d14" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="VOIP" FontFamily="Cascadia Code" FontSize="10" Foreground="{ThemeResource AccentBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="игровой командный голосовой чат" HorizontalAlignment="Right"
                       Foreground="{ThemeResource DimBrush}" FontFamily="Cascadia Code" FontSize="11"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="20,6,20,0">
            <Button x:Name="RoomTabBtn" Content="КОМНАТА" Style="{ThemeResource VcTabButton}"
                    Click="RoomTabBtn_Click" Background="{ThemeResource AccentBrush}" Foreground="#030306" />
            <Button x:Name="SettingsTabBtn" Content="НАСТРОЙКИ" Style="{ThemeResource VcTabButton}"
                    Click="SettingsTabBtn_Click" />
        </StackPanel>

        <Grid x:Name="RoomPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Margin="20,8" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="СЕРВЕР" Style="{ThemeResource VcLabel}" />
                        <TextBox x:Name="ServerBox" Text="194.31.204.5:9987" Style="{ThemeResource VcTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Text="КОМНАТА" Style="{ThemeResource VcLabel}" />
                        <TextBox x:Name="RoomBox" Text="squad" Style="{ThemeResource VcTextBox}" />
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="ConnectBtn" Content="ПОДКЛЮЧИТЬСЯ"
                            Style="{ThemeResource VcButton}" Click="ConnectBtn_Click" MinWidth="150"
                            VerticalAlignment="Bottom" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Text="НИКНЕЙМ" Style="{ThemeResource VcLabel}" />
                        <TextBox x:Name="NameBox" Text="Player" Style="{ThemeResource VcTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="ПАРОЛЬ (AES-GCM)" Style="{ThemeResource VcLabel}" />
                        <PasswordBox x:Name="RoomPasswordBox" FontFamily="Cascadia Code" FontSize="12"
                                     PasswordChanged="RoomPasswordBox_PasswordChanged" />
                    </StackPanel>
                    <ToggleButton x:Name="OpenMicBtn" Grid.Row="1" Grid.Column="2" Content="ОТКРЫТЫЙ МИКРОФОН"
                                  MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Checked="OpenMicBtn_Checked" Unchecked="OpenMicBtn_Unchecked" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock x:Name="PttHint" Text="PTT: [SPACE]" Style="{ThemeResource VcLabel}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="StatusText" Text="отключено" Foreground="{ThemeResource DimBrush}"
                                   FontFamily="Cascadia Code" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="20,4" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="В КОМНАТЕ" Style="{ThemeResource VcLabel}" Margin="0,0,0,8" />
                    <TextBlock x:Name="TalkBadge" Grid.Row="0" Grid.Column="1" Text="●"
                               FontFamily="Cascadia Code" FontSize="14" Visibility="Collapsed" />
                    <ListView x:Name="MembersList" Grid.Row="1" Grid.ColumnSpan="2"
                              Background="Transparent" BorderThickness="0" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="●" FontFamily="Cascadia Code" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code" Foreground="#e8e8f0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
            <Border Margin="20,8" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <TextBlock Text="МИКРОФОН" FontFamily="Cascadia Code" FontSize="16" FontWeight="Bold"
                                   Foreground="{ThemeResource AccentBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="MicDevicesCombo" MinWidth="340" FontFamily="Cascadia Code" FontSize="12"
                                      PlaceholderText="выбор микрофона" SelectionChanged="MicDevicesCombo_SelectionChanged" />
                            <ToggleButton x:Name="MicTestBtn" Content="ТЕСТ МИКРОФОНА" MinWidth="160"
                                          Checked="MicTestBtn_Checked" Unchecked="MicTestBtn_Unchecked" />
                            <ToggleButton x:Name="LoopbackBtn" Content="ПРОСЛУШИВАТЬ СЕБЯ" MinWidth="180"
                                          Checked="LoopbackBtn_Checked" Unchecked="LoopbackBtn_Unchecked" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="УРОВЕНЬ МИКРОФОНА" Style="{ThemeResource VcLabel}" />
                            <Grid x:Name="MicLevelTrack" Height="18" Width="420" HorizontalAlignment="Left"
                                  Background="#181820" CornerRadius="9">
                                <Border x:Name="MicLevelBar" Width="0" HorizontalAlignment="Left"
                                        Background="#00ff88" CornerRadius="9" />
                            </Grid>
                            <TextBlock x:Name="MicLevelText" Text="0%" FontFamily="Cascadia Code"
                                       Foreground="{ThemeResource DimBrush}" FontSize="11" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="ГРОМКОСТЬ МИКРОФОНА" Style="{ThemeResource VcLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Slider x:Name="MicGainSlider" Minimum="0" Maximum="200" Width="360"
                                        HorizontalAlignment="Left" />
                                <TextBlock x:Name="MicGainText" Text="100%" FontFamily="Cascadia Code"
                                           Foreground="{ThemeResource AccentBrush}" FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ToggleButton x:Name="NoiseSuppressBtn" Content="ШУМОПОДАВЛЕНИЕ (RNNOISE)" MinWidth="220"
                                          Checked="NoiseSuppressBtn_Checked" Unchecked="NoiseSuppressBtn_Unchecked" />
                            <TextBlock Text="подавляет шум микрофона, как в TS/DS" Style="{ThemeResource VcLabel}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource CardBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="VoxCore v0.1  •  UDP 9987  •  Opus 48kHz" FontFamily="Cascadia Code"
                           FontSize="11" Foreground="{ThemeResource DimBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>