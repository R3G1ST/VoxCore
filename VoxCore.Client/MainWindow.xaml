<Window
    x:Class="VoxCore.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VoxCore.Client">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="#06060c">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Background="#5865f2" CornerRadius="6" Width="24" Height="24">
                    <TextBlock Text="V" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="White"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="VoxCore" FontFamily="Cascadia Code" FontSize="13" FontWeight="SemiBold"
                           Foreground="#e0e0f0" VerticalAlignment="Center" />
                <TextBlock Text="// THE NEXUS" FontFamily="Cascadia Code" FontSize="11"
                           Foreground="#4a4a6a" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Width="140" HorizontalAlignment="Right" Opacity="0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ConstellationBar -->
            <local:ConstellationBar x:Name="ConstellationBar" Grid.Column="0" Grid.RowSpan="2"
                                    SettingsRequested="ConstellationBar_SettingsRequested"
                                    AddServerRequested="ConstellationBar_AddServerRequested" />

            <!-- SectorNavigation -->
            <local:SectorNavigation x:Name="SectorNav" Grid.Column="1" Grid.Row="0"
                                    ChannelSelected="SectorNav_ChannelSelected"
                                    AddChannelRequested="SectorNav_AddChannelRequested"
                                    AlliesTabRequested="SectorNav_AlliesTabRequested"
                                    PilotSearched="SectorNav_PilotSearched" />

            <!-- CommandBridge (center) -->
            <Grid Grid.Column="2" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <local:VoiceGraphView x:Name="HubView" Grid.RowSpan="4" />
                <local:HomeView x:Name="HomeView" Grid.RowSpan="4" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsView" Grid.RowSpan="4" Visibility="Collapsed" />

                <!-- Voice header bar (shown when connected) -->
                <Border x:Name="VoiceHeaderBar" Grid.Row="0" BorderBrush="#1a1a30" BorderThickness="0,0,0,1"
                        Padding="20,14" Visibility="Collapsed" Background="#10101c">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChannelNameText" Text="нет связи" FontFamily="Cascadia Code"
                                       FontSize="16" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock x:Name="ChannelStatusText" Text="выбери сектор" FontFamily="Cascadia Code"
                                       FontSize="11" Foreground="#6a6a8a" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="LeaveChannelBtn" Content="ПОКИНУТЬ" Style="{ThemeResource VcSmallButton}"
                                Visibility="Collapsed" Click="LeaveChannelBtn_Click" />
                    </Grid>
                </Border>

                <!-- Voice status panel -->
                <StackPanel x:Name="VoiceStatusPanel" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="🔊" FontSize="40" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="выбери сектор" FontFamily="Cascadia Code"
                                   FontSize="14" Foreground="#e0e0f0" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ModeHintText" Text="микрофон активен — просто говори"
                                   FontFamily="Cascadia Code" FontSize="11" Foreground="#6a6a8a"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Voice connected panel -->
                <Border x:Name="VoiceConnectedPanel" Grid.Row="2" Background="#10101c" BorderBrush="#1a1a30"
                        BorderThickness="0,1,0,0" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#00ff88" Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Голографическая связь активна" FontFamily="Cascadia Code"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#00ff88" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="📞" Width="32" Height="32" Padding="0"
                                    Background="#ff3b5c" Foreground="White" BorderThickness="0" CornerRadius="6"
                                    FontSize="14" Click="LeaveChannelBtn_Click"
                                    ToolTipService.ToolTip="разорвать связь" />
                        </Grid>
                        <TextBlock x:Name="ScreenShareStatusText" Grid.Row="1" Text="" FontFamily="Cascadia Code"
                                   FontSize="11" Foreground="#6a6a8a" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="6" Background="#5865f2" Margin="0,0,10,0">
                                <TextBlock Text="🔊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceChannelName" Text="Voice" FontFamily="Cascadia Code"
                                           FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock x:Name="VoiceServerName" Text="VoxCore" FontFamily="Cascadia Code"
                                           FontSize="10" Foreground="#6a6a8a" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="ScreenShareBtn" Width="32" Height="32" Padding="0"
                                              Background="Transparent" BorderThickness="0" FontSize="14"
                                              Checked="ScreenShareBtn_Checked" Unchecked="ScreenShareBtn_Unchecked"
                                              ToolTipService.ToolTip="передача экрана">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🖥️" />
                                        <Border Grid.Column="1" Width="8" Height="8" CornerRadius="4"
                                                Background="#3ba55d" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="0,-2,-2,0" Visibility="Collapsed" x:Name="ScreenShareDot" />
                                    </Grid>
                                </ToggleButton>
                                <ToggleButton x:Name="VideoBtn" Width="32" Height="32" Padding="0"
                                              Background="Transparent" BorderThickness="0" FontSize="14"
                                              ToolTipService.ToolTip="голографическая передача">
                                    <TextBlock Text="📹" />
                                </ToggleButton>
                                <ToggleButton x:Name="NoiseSupBtn" Width="32" Height="32" Padding="0"
                                              Background="Transparent" BorderThickness="0" FontSize="14"
                                              IsChecked="True" ToolTipService.ToolTip="подавление шума">
                                    <TextBlock Text="🎧" />
                                </ToggleButton>
                                <Button x:Name="AudioHubBtn" Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0" FontSize="14"
                                        Click="AudioHubBtn_Click" ToolTipService.ToolTip="аудио-хаб — сеть сектора">
                                    <TextBlock Text="🌌" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Channel chat panel -->
                <Grid x:Name="ChannelChatPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="ChannelChatList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                              SelectionMode="None" Padding="8,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding ColorBrush}">
                                            <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                                       Foreground="White" FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SenderName}" FontFamily="Cascadia Code" FontSize="12"
                                                   FontWeight="Bold" Foreground="#f2f3f5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Code" FontSize="10"
                                                   Foreground="#5a5a6a" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Cascadia Code" FontSize="13"
                                               Foreground="#dbdee1" TextWrapping="Wrap" Margin="36,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1" Background="#08080e" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChannelChatInput" PlaceholderText="введи звёздный журнал..."
                                 FontFamily="Cascadia Code" FontSize="12" Background="#030306" Foreground="#e8e8f0"
                                 BorderBrush="#181820" BorderThickness="1" CornerRadius="8" Padding="12,8"
                                 KeyDown="ChannelChatInput_KeyDown" />
                        <Button Grid.Column="1" Content="➤" Width="36" Height="36" Padding="0"
                                Background="#5865f2" Foreground="White" BorderThickness="0"
                                CornerRadius="8" FontFamily="Cascadia Code" FontSize="14"
                                Margin="8,0,0,0" Click="ChannelChatSend_Click" />
                    </Grid>
                </Grid>

                <!-- DM panel -->
                <Grid x:Name="DmPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10" Background="#08080e" BorderBrush="#181820" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="←" Width="28" Height="28" Padding="0" Background="Transparent"
                                    BorderThickness="0" Foreground="#5a5a6a" FontFamily="Cascadia Code" FontSize="14"
                                    Click="DmBack_Click" />
                            <Border x:Name="DmFriendAvatar" Width="28" Height="28" CornerRadius="14" Background="#5865f2">
                                <TextBlock x:Name="DmFriendLetter" FontFamily="Cascadia Code" FontWeight="Bold"
                                           Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="DmFriendName" FontFamily="Cascadia Code" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ListView x:Name="DmChatList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectionMode="None" Padding="8,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding ColorBrush}">
                                            <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                                       Foreground="White" FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SenderName}" FontFamily="Cascadia Code" FontSize="12"
                                                   FontWeight="Bold" Foreground="#f2f3f5" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Code" FontSize="10"
                                                   Foreground="#5a5a6a" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Cascadia Code" FontSize="13"
                                               Foreground="#dbdee1" TextWrapping="Wrap" Margin="36,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Background="#08080e" Padding="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DmChatInput" PlaceholderText="введи звёздный журнал..."
                                 FontFamily="Cascadia Code" FontSize="12" Background="#030306" Foreground="#e8e8f0"
                                 BorderBrush="#181820" BorderThickness="1" CornerRadius="8" Padding="12,8"
                                 KeyDown="DmChatInput_KeyDown" />
                        <Button Grid.Column="1" Content="➤" Width="36" Height="36" Padding="0"
                                Background="#5865f2" Foreground="White" BorderThickness="0"
                                CornerRadius="8" FontFamily="Cascadia Code" FontSize="14"
                                Margin="8,0,0,0" Click="DmChatSend_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- CrewManifest -->
            <local:CrewManifest x:Name="CrewManifest" Grid.Column="3" Grid.Row="0" />

            <!-- PilotProfile -->
            <local:PilotProfile x:Name="PilotProfile" Grid.Column="1" Grid.Row="1"
                                SettingsRequested="PilotProfile_SettingsRequested"
                                MicToggled="PilotProfile_MicToggled"
                                SpeakerToggled="PilotProfile_SpeakerToggled" />

            <!-- Boot overlay (spans everything) -->
            <local:BootSequenceView x:Name="BootView" Grid.ColumnSpan="4" Grid.RowSpan="2" />
        </Grid>

        <!-- Connecting overlay -->
        <Grid x:Name="ConnectingOverlay" Grid.RowSpan="2" Background="#CC070810" Visibility="Collapsed" Canvas.ZIndex="10">
            <Border CornerRadius="16" BorderThickness="2" BorderBrush="#00e5ff" Background="#E60D0F1E"
                    Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="340">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" Foreground="#00e5ff" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectingTitle" Text="Подключение..." FontFamily="Cascadia Code" FontSize="14"
                               FontWeight="Bold" Foreground="#eaf7ff" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectingStep" Text="Инициализация..." FontFamily="Cascadia Code" FontSize="12"
                               Foreground="#7fe3ff" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel x:Name="ConnectingSteps" Spacing="4" Margin="0,8,0,0">
                        <TextBlock x:Name="Step1" Text="○ Подготовка" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a"/>
                        <TextBlock x:Name="Step2" Text="○ Сбор ICE кандидатов" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a"/>
                        <TextBlock x:Name="Step3" Text="○ Обмен SDP" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a"/>
                        <TextBlock x:Name="Step4" Text="○ Установка соединения" FontFamily="Cascadia Code" FontSize="11" Foreground="#5a617a"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
