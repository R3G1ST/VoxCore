<Window
    x:Class="VoxCore.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#313338">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="248" />
        </Grid.ColumnDefinitions>

        <!-- TITLE BAR -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Grid.ColumnSpan="3" Background="#1e1f22">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Background="#5865f2" CornerRadius="6" Width="24" Height="24">
                    <TextBlock Text="V" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="White"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="VoxCore" FontFamily="Cascadia Code" FontSize="13" FontWeight="SemiBold"
                           Foreground="#dbdee1" VerticalAlignment="Center" />
                <TextBlock Text="— голосовой чат для игр" FontFamily="Cascadia Code" FontSize="11"
                           Foreground="#949ba4" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Width="140" HorizontalAlignment="Right" Opacity="0" />
        </Grid>

        <!-- ЛЕВАЯ ПАНЕЛЬ: каналы / друзья -->
        <Grid Grid.Row="1" Grid.Column="0" Background="#2b2d31">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8,10,8,4" Spacing="4">
                <Button x:Name="ChannelsTabBtn" Content="КАНАЛЫ" Style="{ThemeResource VcSmallButton}"
                        Click="ChannelsTabBtn_Click" />
                <Button x:Name="FriendsTabBtn" Content="ДРУЗЬЯ" Style="{ThemeResource VcSmallButton}"
                        Background="#3f4248" Click="FriendsTabBtn_Click" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ChannelsHeader" Grid.Row="0" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ГОЛОСОВЫЕ КАНАЛЫ" FontFamily="Cascadia Code" FontSize="11"
                                   Foreground="#949ba4" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="AddChannelBtn" Content="＋" FontSize="18"
                                Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Foreground="#949ba4" Click="AddChannelBtn_Click"
                                ToolTipService.ToolTip="создать канал" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChannelsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChannelsPanel" Padding="8,8" Spacing="2" />
                </ScrollViewer>

                <Grid x:Name="FriendsPanel" Grid.RowSpan="2" Background="#2b2d31" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="12,8" Spacing="8">
                        <TextBlock Text="ПОИСК ДРУЗЕЙ" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4" />
                        <TextBox x:Name="SearchBox" PlaceholderText="ник пользователя..."
                                 Background="#1e1f22" Foreground="#dbdee1" BorderBrush="#3f4248"
                                 BorderThickness="1" CornerRadius="6" FontFamily="Cascadia Code" FontSize="13"
                                 KeyDown="SearchBox_KeyDown" />
                        <Button x:Name="SearchBtn" Content="ИСКАТЬ" Style="{ThemeResource VcSmallButton}"
                                HorizontalAlignment="Stretch" Click="SearchBtn_Click" />
                        <TextBlock x:Name="SearchInfo" Text="" FontFamily="Cascadia Code" FontSize="11"
                                   Foreground="#faa61a" TextWrapping="Wrap" />
                    </StackPanel>

                    <ListView x:Name="SearchResultsList" Grid.Row="1" Visibility="Collapsed" MaxHeight="180"
                              Margin="12,0,12,4" Background="Transparent" BorderThickness="0" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="SearchResult_Click">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding ColorBrush}">
                                        <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code"
                                                   FontWeight="Bold" Foreground="White" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code" FontSize="13"
                                                   Foreground="#dbdee1" />
                                        <TextBlock Text="{Binding Status}" FontFamily="Cascadia Code" FontSize="10"
                                                   Foreground="#949ba4" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="＋" FontSize="16" Foreground="#3ba55d"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Padding="8,0,8,8">
                            <StackPanel x:Name="RequestsSection" Spacing="4">
                                <TextBlock Text="ВХОДЯЩИЕ ЗАПРОСЫ" FontFamily="Cascadia Code" FontSize="11"
                                           Foreground="#faa61a" Padding="8,4" />
                                <ListView x:Name="RequestsList" Background="Transparent" BorderThickness="0"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{Binding ColorBrush}">
                                                    <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code"
                                                               FontWeight="Bold" Foreground="White" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code"
                                                               FontSize="13" Foreground="#dbdee1" />
                                                    <TextBlock Text="хочет быть твоим другом" FontFamily="Cascadia Code"
                                                               FontSize="10" Foreground="#949ba4" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                    <Button Content="✓" Width="30" Height="30" Padding="0"
                                                            Background="#3ba55d" BorderThickness="0" Foreground="White"
                                                            Tag="{Binding Id}" Click="RequestAccept_Click" />
                                                    <Button Content="✕" Width="30" Height="30" Padding="0"
                                                            Background="#ed4245" BorderThickness="0" Foreground="White"
                                                            Tag="{Binding Id}" Click="RequestDecline_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="МОИ ДРУЗЬЯ" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4"
                                           Padding="8,4" />
                                <ListView x:Name="FriendsList" Background="Transparent" BorderThickness="0"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{Binding ColorBrush}">
                                                    <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code"
                                                               FontWeight="Bold" Foreground="White" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code"
                                                                   FontSize="13" Foreground="#dbdee1" />
                                                        <Ellipse Width="8" Height="8" Fill="{Binding OnlineBrush}"
                                                                 VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Status}" FontFamily="Cascadia Code"
                                                               FontSize="10" Foreground="#949ba4" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                                    <Button Content="💬" Width="28" Height="28" Padding="0"
                                                            Background="Transparent" BorderThickness="0" Foreground="#949ba4"
                                                            Tag="{Binding Id}" Click="FriendDm_Click"
                                                            ToolTipService.ToolTip="написать" />
                                                    <Button Content="✕" Width="28" Height="28" Padding="0"
                                                            Background="Transparent" BorderThickness="0" Foreground="#949ba4"
                                                            Tag="{Binding Id}" Click="FriendRemove_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ЦЕНТР: голосовой канал + чат -->
        <Grid Grid.Row="1" Grid.Column="1" Background="#313338">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1e1f22" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelNameText" Text="не в канале" FontFamily="Cascadia Code"
                                   FontSize="16" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ChannelStatusText" Text="выбери канал слева" FontFamily="Cascadia Code"
                                   FontSize="11" Foreground="#949ba4" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="LeaveChannelBtn" Content="ПОКИНУТЬ" Style="{ThemeResource VcSmallButton}"
                            Visibility="Collapsed" Click="LeaveChannelBtn_Click" />
                </Grid>
            </Border>

            <StackPanel x:Name="VoiceStatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="🔊" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="выбери канал слева" FontFamily="Cascadia Code"
                               FontSize="14" Foreground="#b5bac1" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ModeHintText" Text="микрофон активен — просто говори"
                               FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Чат в канале -->
            <Grid x:Name="ChannelChatPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="ChannelChatList" Grid.Row="0" Background="Transparent" BorderThickness="0"
                          SelectionMode="None" Padding="8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{Binding ColorBrush}">
                                        <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                                   Foreground="White" FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding SenderName}" FontFamily="Cascadia Code" FontSize="12"
                                               FontWeight="Bold" Foreground="#f2f3f5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Code" FontSize="10"
                                               Foreground="#5a5a6a" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Cascadia Code" FontSize="13"
                                           Foreground="#dbdee1" TextWrapping="Wrap" Margin="36,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="1" Background="#2b2d31" Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChannelChatInput" PlaceholderText="напиши сообщение..."
                             FontFamily="Cascadia Code" FontSize="12" Background="#313338" Foreground="#dbdee1"
                             BorderBrush="#3f4248" BorderThickness="1" CornerRadius="8" Padding="12,8"
                             KeyDown="ChannelChatInput_KeyDown" />
                    <Button Grid.Column="1" Content="➤" Width="36" Height="36" Padding="0"
                            Background="#5865f2" Foreground="White" BorderThickness="0"
                            CornerRadius="8" FontFamily="Cascadia Code" FontSize="14"
                            Margin="8,0,0,0" Click="ChannelChatSend_Click" />
                </Grid>
            </Grid>

            <!-- Личные сообщения -->
            <Grid x:Name="DmPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12,10" Background="#2b2d31" BorderBrush="#1e1f22" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="←" Width="28" Height="28" Padding="0" Background="Transparent"
                                BorderThickness="0" Foreground="#949ba4" FontFamily="Cascadia Code" FontSize="14"
                                Click="DmBack_Click" />
                        <Border x:Name="DmFriendAvatar" Width="28" Height="28" CornerRadius="14" Background="#5865f2">
                            <TextBlock x:Name="DmFriendLetter" FontFamily="Cascadia Code" FontWeight="Bold"
                                       Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="DmFriendName" FontFamily="Cascadia Code" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ListView x:Name="DmChatList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                          SelectionMode="None" Padding="8,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{Binding ColorBrush}">
                                        <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                                   Foreground="White" FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding SenderName}" FontFamily="Cascadia Code" FontSize="12"
                                               FontWeight="Bold" Foreground="#f2f3f5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Code" FontSize="10"
                                               Foreground="#5a5a6a" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Text}" FontFamily="Cascadia Code" FontSize="13"
                                           Foreground="#dbdee1" TextWrapping="Wrap" Margin="36,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" Background="#2b2d31" Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DmChatInput" PlaceholderText="напиши сообщение..."
                             FontFamily="Cascadia Code" FontSize="12" Background="#313338" Foreground="#dbdee1"
                             BorderBrush="#3f4248" BorderThickness="1" CornerRadius="8" Padding="12,8"
                             KeyDown="DmChatInput_KeyDown" />
                    <Button Grid.Column="1" Content="➤" Width="36" Height="36" Padding="0"
                            Background="#5865f2" Foreground="White" BorderThickness="0"
                            CornerRadius="8" FontFamily="Cascadia Code" FontSize="14"
                            Margin="8,0,0,0" Click="DmChatSend_Click" />
                </Grid>
            </Grid>

            <Border Grid.Row="3" BorderBrush="#1e1f22" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <ToggleButton x:Name="ModeToggle" Content="🎤 АКТИВНЫЙ" MinWidth="120" Height="40"
                                  IsChecked="True" Checked="ModeToggle_Checked" Unchecked="ModeToggle_Unchecked"
                                  ToolTipService.ToolTip="режим микрофона: активный / PTT" />
                    <ToggleButton x:Name="MicMuteBtn" Content="🎙️" MinWidth="48" Height="40"
                                  Checked="MicMuteBtn_Checked" Unchecked="MicMuteBtn_Unchecked" />
                    <ToggleButton x:Name="HeadMuteBtn" Content="🔊" MinWidth="48" Height="40"
                                  Checked="HeadMuteBtn_Checked" Unchecked="HeadMuteBtn_Unchecked" />
                    <ToggleButton x:Name="DeafenBtn" Content="🔇" MinWidth="48" Height="40"
                                  Checked="DeafenBtn_Checked" Unchecked="DeafenBtn_Unchecked" />
                    <Button x:Name="SettingsBtn" Content="⚙️" MinWidth="48" Height="40"
                            Click="SettingsBtn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ: участники -->
        <Grid Grid.Row="1" Grid.Column="2" Background="#2b2d31">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="УЧАСТНИКИ" FontFamily="Cascadia Code" FontSize="11" Foreground="#949ba4"
                       Padding="16,14" />
            <ListView x:Name="MembersList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                      SelectionMode="None" Padding="8,0,8,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="6,5">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{Binding ColorBrush}">
                                <TextBlock Text="{Binding Letter}" FontFamily="Cascadia Code" FontWeight="Bold"
                                           Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code" FontSize="14"
                                               Foreground="#dbdee1" />
                                    <TextBlock Text="{Binding SpeakingText}" FontSize="12" Foreground="{Binding SpeakingBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" FontFamily="Cascadia Code" FontSize="10"
                                           Foreground="#949ba4" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- КАРТОЧКА АККАУНТА -->
        <Border Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Background="#232428" BorderBrush="#1e1f22"
                BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AvatarBorder" Width="36" Height="36" CornerRadius="18" Background="#5865f2">
                    <TextBlock x:Name="AvatarLetter" FontFamily="Cascadia Code" FontWeight="Bold" Foreground="White"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" FontFamily="Cascadia Code" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="UserStatusText" Text="в сети" FontFamily="Cascadia Code" FontSize="10"
                               Foreground="#3ba55d" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="34" Height="34" Padding="0" Background="Transparent"
                        BorderThickness="0" Foreground="#949ba4" Click="LogoutBtn_Click"
                        ToolTipService.ToolTip="выйти" />
            </Grid>
        </Border>
    </Grid>
</Window>