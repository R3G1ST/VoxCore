<Window
    x:Class="VoxCore.Client.AuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1e1f22">
        <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="VoxCore" FontFamily="Cascadia Code" FontSize="34" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="голосовой чат для игр" FontFamily="Cascadia Code" FontSize="12"
                           Foreground="#949ba4" HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="НИКНЕЙМ" FontFamily="Cascadia Code" FontSize="10" Foreground="#b5bac1" />
            <TextBox x:Name="NameBox" Style="{ThemeResource AuthTextBox}" />

            <TextBlock Text="ПАРОЛЬ" FontFamily="Cascadia Code" FontSize="10" Foreground="#b5bac1" />
            <PasswordBox x:Name="PassBox" Style="{ThemeResource AuthPassBox}" KeyDown="PassBox_KeyDown" />

            <Button x:Name="AuthBtn" Content="ВОЙТИ" Style="{ThemeResource AuthButton}" Click="AuthBtn_Click"
                    HorizontalAlignment="Stretch" />
            <Button x:Name="ToggleBtn" Content="нет аккаунта? зарегистрироваться" Style="{ThemeResource AuthLinkButton}"
                    Click="ToggleBtn_Click" HorizontalAlignment="Center" />

            <TextBlock x:Name="ErrorText" Text="" Foreground="#f23f42" FontFamily="Cascadia Code" FontSize="12"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>